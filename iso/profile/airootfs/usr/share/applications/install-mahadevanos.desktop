[Desktop Entry]
Type=Application
Name=Install MahaDevan's OS
Comment=Install this system to disk (offline, Garuda-style)
# The wrapper runs Calamares as root on the live Wayland session, makes its
# window fullscreen and opens a terminal with the log if it cannot start.
Exec=/usr/local/bin/mahadevanos-installer
Icon=calamares
Terminal=false
Categories=System;
StartupNotify=true
