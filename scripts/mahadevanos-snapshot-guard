#!/usr/bin/env bash
# mahadevanos-snapshot-guard - never let snapper's cleanup delete the last
# known-good snapshot.
#
#   mahadevanos-snapshot-guard [-q|--quiet]
#
# snapper deletes old snapshots with its number and timeline algorithms; its
# space-limit pass can delete more when the disk fills. The one thing it never
# deletes is a snapshot whose userdata says important=yes (see
# snapper-configs(5): NUMBER_LIMIT_IMPORTANT counts those separately and keeps
# the youngest of them). This script keeps exactly ONE such anchor:
#
#   * the newest snapshot becomes cleanup-algorithm=number + important=yes, so
#     neither the timeline algorithm (it only considers timeline snapshots) nor
#     the number algorithm (which respects important=yes) can remove it;
#   * the previous anchor is downgraded to important=no, so anchors do not pile
#     up forever and the disk still cannot fill.
#
# The anchor number is remembered in /var/lib/mahadevanos/snapshot-anchor. It runs
# from mahadevanos-snapshot-guard.timer (five minutes after boot and hourly, i.e.
# before and after snapper-cleanup.timer's hourly pass), and once at the end of
# the install so a fresh system already has a protected snapshot.
#
# Exit status: 0 on success, 1 if snapper could not be asked at all. A missing
# snapper config or a system with no snapshots is not an error (nothing to do).
set -uo pipefail

CONFIG="${MAHADEVANOS_SNAPSHOT_CONFIG:-root}"
# Only used for the "is there a config at all" precheck. snapper itself always
# reads /etc/snapper/configs; tests/docs/check-learning.sh points this at a
# temporary directory to exercise the anchor logic without a real snapper.
CONFIG_DIR="${MAHADEVANOS_SNAPSHOT_CONFIG_DIR:-/etc/snapper/configs}"
STATE_DIR="${MAHADEVANOS_SNAPSHOT_STATE_DIR:-/var/lib/mahadevanos}"
STATE="$STATE_DIR/snapshot-anchor"
SNAPPER="${SNAPPER:-snapper}"
# Extra arguments for every snapper call. The installer runs this inside the
# target chroot with SNAPPER_OPTS=--no-dbus, where there is no snapperd to reach.
SNAPPER_OPTS="${SNAPPER_OPTS:-}"
read -r -a snapper_extra <<<"$SNAPPER_OPTS"

quiet=0
for arg in "$@"; do
  case "$arg" in
    -q|--quiet) quiet=1 ;;
    -h|--help) sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf 'mahadevanos-snapshot-guard: unknown argument: %s\n' "$arg" >&2; exit 2 ;;
  esac
done

say() { (( quiet )) || printf 'snapshot-guard: %s\n' "$*"; }

[[ -f "$CONFIG_DIR/$CONFIG" ]] || { say "no snapper config '$CONFIG'; nothing to protect"; exit 0; }
command -v "$SNAPPER" >/dev/null 2>&1 || { printf 'snapshot-guard: snapper is not installed\n' >&2; exit 1; }

snapper_cmd() { "$SNAPPER" ${snapper_extra[@]+"${snapper_extra[@]}"} "$@"; }

# Snapshot numbers, one per line. The plain table is parsed instead of --csvout:
# its first column is always the number, and cutting at the first separator
# means a description (which may contain commas or digits) can never be
# mistaken for one. 0 is snapper's pseudo-entry for the live filesystem, not a
# snapshot, so it is dropped.
list_numbers() {
  snapper_cmd -c "$CONFIG" list -t all 2>/dev/null |
    sed -e 's/[│|].*//' -e 's/[^0-9]//g' |
    grep -E '^[1-9][0-9]*$'
}

mapfile -t numbers < <(list_numbers | tail -n +2 | grep -E '^[0-9]+$' | sort -n)
if (( ${#numbers[@]} == 0 )); then
  if ! snapper_cmd -c "$CONFIG" list -t all >/dev/null 2>&1; then
    printf 'snapshot-guard: snapper -c %s list failed\n' "$CONFIG" >&2
    exit 1
  fi
  say "no snapshots in config '$CONFIG'; nothing to protect"
  exit 0
fi
newest="${numbers[-1]}"

previous=""
if [[ -s "$STATE" ]]; then
  previous="$(head -n1 "$STATE" | tr -dc '0-9')"
fi

if [[ "$newest" == "$previous" ]]; then
  say "snapshot $newest is already the protected anchor"
  exit 0
fi

# Protect the new anchor first, so cleanup can never run between the two steps
# with no anchor at all.
if ! snapper_cmd -c "$CONFIG" modify --cleanup-algorithm number --userdata "important=yes" "$newest" >/dev/null; then
  printf 'snapshot-guard: could not mark snapshot %s as important\n' "$newest" >&2
  exit 1
fi
say "snapshot $newest is now the protected anchor (important=yes)"

# Downgrade the old anchor. It may have been deleted already; that is fine.
if [[ -n "$previous" && "$previous" != "$newest" ]]; then
  if snapper_cmd -c "$CONFIG" modify --userdata "important=no" "$previous" >/dev/null 2>&1; then
    say "released the previous anchor (snapshot $previous)"
  else
    say "the previous anchor (snapshot $previous) no longer exists"
  fi
fi

install -d -m 755 "$STATE_DIR"
printf '%s\n' "$newest" >"$STATE"
exit 0
