# /etc/default/grub for MahaDevan's OS (installed by mahadevanos-branding).
# Kernels live inside the Btrfs root so a snapshot rollback also rolls the kernel,
# which is the reason GRUB was chosen over systemd-boot (blueprint §2 #2).

GRUB_DEFAULT=saved
GRUB_SAVEDEFAULT=true
# At least 3 seconds and a visible menu: the Snapshots submenu (grub-btrfs) and
# the linux-lts fallback must be reachable without holding a key at the right
# moment. tests/install/snapshots-check.sh and gui-install-audit.sh assert that
# /etc/default/grub and the generated grub.cfg keep a timeout of 3 or more.
GRUB_TIMEOUT=5
GRUB_TIMEOUT_STYLE=menu
# Without this, grub-mkconfig hides every kernel but the default one in an
# "Advanced options" submenu, so linux-lts is not a menu entry the user (or the
# boot test) can pick as the fallback.
GRUB_DISABLE_SUBMENU=y
GRUB_DISTRIBUTOR="MahaDevan OS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet nowatchdog zswap.enabled=0"
GRUB_CMDLINE_LINUX=""

# `linux` is the default entry, `linux-lts` stays as the recovery fallback.
# /etc/grub.d/10_linux puts the kernel named here first in the menu, so entry 0
# (and therefore a fresh GRUB_DEFAULT=saved) is vmlinuz-linux. Without it
# grub-mkconfig sorts by version and 6.18.x-lts lands above 7.2.x.
GRUB_TOP_LEVEL="/boot/vmlinuz-linux"

# Find other operating systems (dual boot). Requires os-prober.
GRUB_DISABLE_OS_PROBER=false

# Branding theme; grub-btrfs adds the "Snapshots" submenu into this menu, after
# the kernel entries (so entry 0 stays `linux` and entry 3 `linux-lts`).
GRUB_THEME="/boot/grub/themes/mahadevanos/theme.txt"
GRUB_BACKGROUND="/boot/grub/themes/mahadevanos/background.png"

# Keep a visible menu after a failed boot so snapshots stay reachable.
GRUB_RECORDFAIL_TIMEOUT=10
GRUB_DISABLE_RECOVERY=false

# GRUB is also reachable on ttyS0, so the installed disk can be booted and its
# kernel selected unattended in QEMU (scripts/test-install-auto.sh --boot-installed
# --kernel linux|linux-lts, tests/install/verify-installed.sh). On hardware with
# no serial port the `serial` command fails harmlessly and the normal console is
# used; nothing else depends on it.
GRUB_TERMINAL_INPUT="console serial"
GRUB_TERMINAL_OUTPUT="console serial"
GRUB_SERIAL_COMMAND="serial --unit=0 --speed=115200 --word=8 --parity=no --stop=1"
