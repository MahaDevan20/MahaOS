# Maintainer: MahaDevan
# System-wide desktop defaults. Everything lands under /etc/xdg so a user's own
# ~/.config always wins, and /etc/skel gets a copy for newly created accounts.
pkgname=mahadevanos-settings
pkgver=0.1.0
pkgrel=1
pkgdesc="Hyprland, Kitty, Dolphin and snapper defaults for MahaDevan's OS"
arch=('any')
url="https://github.com/mahadevan"
license=('MIT')
depends=('hyprland' 'kitty' 'dolphin' 'snapper')
source=("${pkgname}-assets.tar.zst")
sha256sums=('SKIP')

prepare() {
  tar -xf "${srcdir}/${pkgname}-assets.tar.zst" -C "$srcdir"
}

package() {
  # Hyprland 0.57 reads hyprland.lua; a .conf is ignored and the compositor falls
  # back to its autogenerated config (the "autogenerated config" banner).
  install -Dm644 "$srcdir/configs/hypr/hyprland.lua" \
    "$pkgdir/etc/xdg/hypr/hyprland.lua"

  install -Dm644 "$srcdir/configs/kitty/kitty.conf" "$pkgdir/etc/xdg/kitty/kitty.conf"
  install -Dm644 "$srcdir/configs/dolphin/dolphinrc" "$pkgdir/etc/xdg/dolphinrc"
  install -Dm644 "$srcdir/configs/snapper/root" "$pkgdir/etc/snapper/configs/root"

  # Skeleton for new users, so a first login already looks like MahaDevan's OS.
  install -Dm644 "$srcdir/configs/hypr/hyprland.lua" \
    "$pkgdir/etc/skel/.config/hypr/hyprland.lua"
  install -Dm644 "$srcdir/configs/kitty/kitty.conf" \
    "$pkgdir/etc/skel/.config/kitty/kitty.conf"

  install -Dm644 "$srcdir/configs/quickshell/README.md" \
    "$pkgdir/usr/share/doc/mahadevanos/quickshell.md"

  # MIT requires the license text to travel with the package.
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
